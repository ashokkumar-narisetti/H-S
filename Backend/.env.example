# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# JWT Secret Key for Session Tokens
JWT_SECRET="your-super-secret-jwt-key"

# Allowed Frontend Client URLs (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# SMTP / no-reply email settings for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@hiandshi.shop

# PostgreSQL Database URL (Supabase, Neon, or Local Postgres)
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"
